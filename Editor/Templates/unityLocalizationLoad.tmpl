        }

        public async global::UnityEngine.Awaitable LoadAsync(string location,
            string language, global::GameDBLibrary.IGameDBDataLoader loader,
            global::System.Collections.Generic.IReadOnlyList<string> fallbackLanguages,
            bool notify = true,
            global::System.Threading.CancellationToken cancellationToken = default)
        {
            var selection = PrepareLocalizationSelection(language, fallbackLanguages);
            await LoadLocalizationDataAsync(location, loader,
