
        public global::System.Exception Load(string path, string language,
            bool notify = true)
        {
            return Load(path, language,
                global::System.Array.Empty<string>(), notify);
        }

        public global::System.Exception Load(string path, string language,
            global::System.Collections.Generic.IReadOnlyList<string> fallbackLanguages,
            bool notify = true)
        {
            GameDBLocalizationSelection selection;
            try
            {
                selection = PrepareLocalizationSelection(language, fallbackLanguages);
            }
            catch (global::System.Exception exception)
            {
                return exception;
            }

            return LoadLocalizationData(() =>
            {
                var gameDBResource = global::UnityEngine.Resources.Load<global::UnityEngine.TextAsset>(path);

                if (gameDBResource == null)
                {
                    throw new global::System.ArgumentException($"Failed to load GameDB {Name} at path: {path}");
                }

                return gameDBResource.text;
            }, selection.CreateColumns(), notify, selection);
        }

        public async global::UnityEngine.Awaitable LoadAsync(string path,
            string language, bool notify = true,
            global::System.Threading.CancellationToken cancellationToken = default)
        {
            await LoadAsync(path, language,
                global::System.Array.Empty<string>(), notify, cancellationToken);
        }

        public async global::UnityEngine.Awaitable LoadAsync(string path,
            string language,
            global::System.Collections.Generic.IReadOnlyList<string> fallbackLanguages,
            bool notify = true,
            global::System.Threading.CancellationToken cancellationToken = default)
        {
            var selection = PrepareLocalizationSelection(language, fallbackLanguages);
            await LoadLocalizationDataAsync(path,
                global::GameDBLibraryUnity.ResourcesGameDBDataLoader.Instance,
                selection.CreateColumns(), notify, selection, cancellationToken);
        }

        public async global::UnityEngine.Awaitable LoadAsync(string location,
            string language, global::GameDBLibrary.IGameDBDataLoader loader,
